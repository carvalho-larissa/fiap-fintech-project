# Java build output
backend/out/
*.class

# IntelliJ IDEA (keep shared project files, ignore user-specific ones)
.idea/workspace.xml
.idea/shelf/
**/.idea/workspace.xml
**/.idea/shelf/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
~$*
*.tmp

# Database credentials (never versioned — see database/.env.example)
database/.env.local
*.credentials
.env
.env.*
!.env.example

# Python caches (document generator)
__pycache__/
*.pyc
